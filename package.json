{
  "name": "600-cau-ly-thuyet-lai-xe-tiktok-live",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "setup": "npm install",
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --platform=node --bundle --format=cjs --outfile=dist-server/server.cjs --external:vite",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js release",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"tsx server.ts\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build:mac": "npm run build && npm run build:server && electron-builder --mac --arm64",
    "electron:build:win": "npm run build && npm run build:server && electron-builder --win",
    "electron:build:all": "npm run build && npm run build:server && electron-builder -mw"
  },
  "build": {
    "appId": "com.driving.tiktoklive",
    "productName": "600 Cau Ly Thuyet Lai Xe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "public/**/*",
      "electron/**/*",
      ".data/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist-server/**/*",
      "public/**/*",
      ".data/**/*"
    ],
    "mac": {
      "icon": "electron/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "title": "600 Cau Ly Thuyet Lai Xe Installer",
      "icon": "electron/icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 170,
          "type": "file"
        },
        {
          "x": 370,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "msedge-tts": "2.1.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.186.1",
    "tiktok-live-connector": "^2.5.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.6",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wait-on": "^9.5.1"
  }
}
